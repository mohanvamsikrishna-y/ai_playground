# Environment mode: "local" or "prod"
# - local: Enables Ollama models and /ollama/* endpoints
# - prod: Disables Ollama, cloud-only mode
PLAYGROUND_ENV=local

# CORS allowed origins (comma-separated)
# Used by backend to allow frontend requests
PLAYGROUND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Ollama base URL (for local mode)
# - Mac/Windows with Docker: use http://host.docker.internal:11434
# - Linux with docker-compose.ollama.yml: use http://ollama:11434
# - Running locally without Docker: use http://localhost:11434
PLAYGROUND_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Frontend API base URL
# This is the URL the browser uses to call the backend API
# Should be http://localhost:8000 for local development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: Server-side API keys (for fallback)
# Users can also provide keys via browser localStorage (preferred)
# PLAYGROUND_GEMINI_API_KEY=your_gemini_key_here
# PLAYGROUND_DEEPSEEK_API_KEY=your_deepseek_key_here
